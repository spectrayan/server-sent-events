{
  "name": "sse-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/sse-client/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/libs/sse-client/dist"],
      "options": {
        "command": "tsup src/index.ts --format esm,cjs --dts --clean --out-dir dist",
        "cwd": "libs/sse-client"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/sse-client/vitest.config.mts"
      }
    }
  }
}
