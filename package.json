{
  "name": "@spectrayan/sse",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx build ng-sse-client && npm run build:sse-client && npm run build:react-sse",
    "test": "nx test ng-sse-client && npm run test:sse-client && npm run test:react-sse",
    "build:client": "nx build ng-sse-client",
    "test:client": "nx test ng-sse-client",
    "build:sse-client": "tsup libs/sse-client/src/index.ts --format esm,cjs --dts --clean --out-dir libs/sse-client/dist",
    "test:sse-client": "vitest run --config libs/sse-client/vitest.config.mts",
    "build:react-sse": "tsup libs/react-sse/src/index.ts --format esm,cjs --dts --clean --out-dir libs/react-sse/dist --external react",
    "test:react-sse": "vitest run --config libs/react-sse/vitest.config.mts",
    "pack:client": "nx build ng-sse-client && npm pack dist/libs/ng-sse-client",
    "pack:sse-client": "npm run build:sse-client && cd libs/sse-client && npm pack",
    "pack:react-sse": "npm run build:react-sse && cd libs/react-sse && npm pack"
  },
  "private": true,
  "dependencies": {
